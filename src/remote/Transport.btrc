import Library.FileSystem;
import Library.Map;
import Library.Process;
import Library.Strings;
import Library.Vector;

class TransportResponse {
    public int status = 0;  // 0: no answer, see error
    public string body = "";
    public string error = "";
    public Map<string, string> headers = {};  // names lower-cased

    public bool answered() { return self.status != 0; }

    public bool ok() { return self.status >= 200 && self.status < 300; }

    public string header(string name) { return self.headers.getOrDefault(name.toLower(), ""); }
}

class Transport {  // one curl process per request
    private string scratch;
    private int sequence = 0;
    public int timeoutSeconds = 120;
    public int stallSeconds = 60;  // a transfer may stall this long

    public Transport(string scratch) {
        self.scratch = scratch;
        FileSystem.mkdirp(scratch);
    }

    private string temporary(string kind) {
        self.sequence++;
        return f"{self.scratch}/{kind}-{self.sequence}";
    }

    class string quoted(string value) { return value.replace("\\", "\\\\").replace("\"", "\\\"").replace("\n", "\\n").replace("\r", "\\r").replace("\t", "\\t"); }  // as curl's config files escape

    private string sealed(Vector<string> urls, Vector<string> headers) {  // a command line is readable by every process
        Vector<string> lines = [];
        for header in headers { lines.push(f"header = \"{Transport.quoted(header)}\""); }
        for url in urls { lines.push(f"url = \"{Transport.quoted(url)}\""); }
        string path = self.temporary("request");
        FileSystem.writeAtomic(path, Strings.join(lines, "\n") + "\n", 0o600);  // unwritten, curl has no URL and fails
        return path;
    }

    private Vector<string> arguments(string method, string request, string headerFile) {
        return ["-sS", "--proto", "=http,https", "--request", method, "--dump-header", headerFile, "--write-out", "%{http_code}", "--header", "Expect:", "--config", request];  // Expect: send bodies at once, without asking first
    }

    private TransportResponse finish(ExecResult ran, string request, string headerFile, string bodyFile, bool keepBody) {
        TransportResponse response = TransportResponse();
        if (ran.code != 0) {
            response.error = ran.wasTimedOut() ? "the request timed out" : f"curl failed ({ran.code}): {ran.stderr().trim()}";
        } else {
            response.status = ran.stdout().trim().toInt();
            if (response.status == 0) { response.error = "curl reported no HTTP status"; }
        }
        for line in Strings.split(FileSystem.readText(headerFile), "\n") {
            string text = line.trim();
            if (text.startsWith("HTTP/")) { response.headers.clear(); }  // keep the last answer's headers
            int colon = text.indexOf(":");
            if (colon > 0) { response.headers.put(text.substring(0, colon).toLower(), text.substring(colon + 1, text.len() - colon - 1).trim()); }
        }
        if (keepBody && FileSystem.exists(bodyFile)) { response.body = FileSystem.readText(bodyFile); }
        FileSystem.removeIfExists(request);
        FileSystem.removeIfExists(headerFile);
        if (keepBody) { FileSystem.removeIfExists(bodyFile); }
        return response;
    }

    public TransportResponse send(string method, string url, Vector<string> headers, string body = "") {
        string headerFile = self.temporary("headers");
        string bodyFile = self.temporary("body");
        string request = self.sealed([url], headers);
        Vector<string> arguments = self.arguments(method, request, headerFile);
        arguments.push("--max-time");
        arguments.push(Strings.fromInt(self.timeoutSeconds));
        arguments.push("--output");
        arguments.push(bodyFile);
        if (!body.isEmpty() || method.equals("POST") || method.equals("PATCH") || method.equals("PUT")) {
            arguments.push("--data-binary");
            arguments.push("@-");
        }
        ExecResult ran = ChildProcess.run("curl", arguments, timeoutMilliseconds=(self.timeoutSeconds + 5) * 1000, stdinData=body);
        return self.finish(ran, request, headerFile, bodyFile, true);
    }

    public TransportResponse download(string url, Vector<string> headers, string path) {  // check the status before trusting the file
        string headerFile = self.temporary("headers");
        string request = self.sealed([url], headers);
        Vector<string> arguments = self.arguments("GET", request, headerFile);
        arguments.push("--speed-limit");
        arguments.push("1");
        arguments.push("--speed-time");
        arguments.push(Strings.fromInt(self.stallSeconds));
        arguments.push("--output");
        arguments.push(path);
        ExecResult ran = ChildProcess.run("curl", arguments);
        return self.finish(ran, request, headerFile, path, false);
    }

    // Several whole files at once, over one connection where the server allows it. The status of each, in the
    // order given; 0 for one that got no answer. A file is only to be trusted when its status says so.
    public Vector<int> downloadSeveral(Vector<string> urls, Vector<string> headers, Vector<string> paths) {
        Vector<string> arguments = ["-sS", "--proto", "=http,https", "--parallel", "--parallel-max", Strings.fromInt(urls.len), "--write-out", "%{http_code} %{filename_effective}\n", "--speed-limit", "1", "--speed-time", Strings.fromInt(self.stallSeconds)];
        string request = self.sealed(urls, headers);
        arguments.push("--config");
        arguments.push(request);
        for path in paths {  // the first output is the first URL's
            arguments.push("--output");
            arguments.push(path);
        }
        ExecResult ran = ChildProcess.run("curl", arguments);
        FileSystem.removeIfExists(request);
        Map<string, int> answered = {};
        for line in Strings.split(ran.stdout(), "\n") {
            int space = line.indexOf(" ");
            if (space > 0) { answered.put(line.substring(space + 1, line.len() - space - 1).trim(), line.substring(0, space).toInt()); }
        }
        Vector<int> statuses = [];
        for path in paths { statuses.push(answered.getOrDefault(path, 0)); }
        return statuses;
    }

    // The file from `offset` on. curl resumes no HTTP upload by itself, so for the rest of a file it is given
    // those bytes on its input, and told where they belong and how many they are.
    public TransportResponse upload(string method, string url, Vector<string> headers, string path, long long offset = 0LL) {
        string headerFile = self.temporary("headers");
        string bodyFile = self.temporary("body");
        Vector<string> said = [];
        said.extend(headers);
        if (offset > 0LL) {
            long long size = FileSystem.stat(path).size;
            said.extend([f"Content-Range: bytes {offset}-{size - 1LL}/{size}", f"Content-Length: {size - offset}", "Transfer-Encoding:"]);  // a length of its own, and so no chunks
        }
        string request = self.sealed([url], said);
        Vector<string> arguments = self.arguments(method, request, headerFile);
        arguments.push("--speed-limit");
        arguments.push("1");
        arguments.push("--speed-time");
        arguments.push(Strings.fromInt(self.stallSeconds));
        arguments.push("--output");
        arguments.push(bodyFile);
        arguments.push("--upload-file");
        arguments.push(offset > 0LL ? "-" : path);
        if (offset == 0LL) { return self.finish(ChildProcess.run("curl", arguments), request, headerFile, bodyFile, true); }
        Vector<string> piped = ["-c", "first=$1; file=$2; shift 2; tail -c \"+$first\" -- \"$file\" | curl \"$@\"", "sh", f"{offset + 1LL}", path];
        piped.extend(arguments);
        return self.finish(ChildProcess.run("sh", piped), request, headerFile, bodyFile, true);
    }
}
