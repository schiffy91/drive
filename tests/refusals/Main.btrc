import Library.CLI;
import testkit.Lab;
import ../Fixture.btrc;

// What the client does when it is told no, or told something it cannot be sure of. The disk fills while a pinned
// folder downloads, the Drive has no room for an upload, the sign-in is withdrawn, the Drive reports a change it
// does not describe or forgets where its changes were read to, and the store is in a format of another client.
// Each time: nothing is shown as complete that is not, nothing is deleted on either side, the engine says what
// is wrong and waits instead of trying over and over, and it carries on by itself once the reason is gone.
class RefusalScenario {
    private DriveFixture drive;
    private Guest machine;
    private string mount;
    private string store;
    private string source;
    private string game = "";  // the pinned folder's id on the Drive
    private Vector<string> pinned = ["g1", "g2", "g3", "g4"];
    private string engine = "--quiet 1 --machine TEST --budget-files 0 --pin Game --full-wait 30";

    public RefusalScenario(Guest machine) {
        self.machine = machine;
        self.drive = DriveFixture(machine);
        self.mount = self.drive.mount;
        self.store = self.drive.store;
        self.source = self.drive.source;
    }

    private string status() { return self.drive.drive("status"); }

    private void waitsFor(string said, int seconds = 0) { self.machine.waitUntil(f"drive status --runtime {self.drive.runtime} > /tmp/status; cat /tmp/status; grep -q '{said}' /tmp/status", seconds); }  // if it never says so, what it did say is in the failure

    private string logged(string what) { return self.machine.succeed(f"journalctl -u drive-engine.service --no-pager | grep -c '{what}' || true").trim(); }  // how many lines of the engine's log say it

    private string requests() { return self.drive.control("log?clear=1"); }  // what the Drive was asked since the last look, one request to a line

    private int times(string requests, string request) {
        int count = 0;
        for line in Strings.split(requests, "\n") {
            if (line.startsWith(request)) { count++; }
        }
        return count;
    }

    private string timesOnDrive(string name) { return self.machine.succeed(f"curl -sS -X POST '{self.drive.fake}/__control/dump' | python3 /var/lib/drive-test/entries.py {name} | grep -c ' False$' || true").trim(); }

    private void prepare() {
        self.drive.prepare();
        for name in self.pinned { self.machine.succeed(f"head -c 4000000 /dev/urandom > {self.source}/{name}"); }
        self.machine.succeed(f"head -c 200000 /dev/urandom > {self.source}/kept && printf 'from the Drive\\n' > {self.source}/text");
        self.machine.succeed(f"mkdir -p {self.store} && truncate -s 96M /var/lib/store.img && mkfs.ext4 -q -m 0 /var/lib/store.img && mount -o loop /var/lib/store.img {self.store}");  // a disk of the store's own, small enough to fill
        self.drive.startFake();
        self.drive.put(self.drive.folder("root", "Docs"), "kept.bin", "kept");
        self.game = self.drive.folder("root", "Game");
        self.drive.startEngine(self.engine);
        self.drive.startDoor();
        self.machine.succeed(f"cmp {self.mount}/Docs/kept.bin {self.source}/kept && echo 'written here' > {self.mount}/notes.txt");
        self.machine.waitUntil(f"test -n \"$(getfattr --absolute-names -n user.drive.id --only-values {self.store}/tree/notes.txt 2>/dev/null)\" && drive status --runtime {self.drive.runtime} | grep -q ' 0 changes to send'");
    }

    private void diskFull() {
        print("The disk fills while a pinned folder downloads");
        self.machine.succeed(f"fallocate -l $(( $(df --output=avail -B1 {self.store} | tail -1) - 14000000 )) {self.store}/filler");  // room for two of the four files and the copy each arrives as
        for name in self.pinned { self.drive.put(self.game, f"{name}.bin", name); }
        self.machine.waitUntil(f"test \"$(ls {self.store}/tree/Game | wc -l)\" = 4");
        self.waitsFor("to download (no room on the disk)");
        int here = 0;
        for name in self.pinned {
            if (self.drive.state(f"Game/{name}.bin") == "local") {
                here++;
                self.machine.succeed(f"cmp {self.store}/tree/Game/{name}.bin {self.source}/{name}");  // a file that counts as here is all of the Drive's file
            } else {
                Check.equal(self.drive.state(f"Game/{name}.bin"), "cloud", f"{name}.bin has not arrived and is not shown as if it had");
            }
        }
        Check.that(here >= 1 && here <= 3, f"part of the folder arrived whole and the rest waits: {here} of 4 files are here");
        string status = self.status();
        Check.that(status.startsWith("online") && status.contains(f" {4 - here} to download (no room on the disk)"), f"the status says what is waiting and why, and does not call it being offline: {status}");

        print("While it waits it neither tries over and over nor makes room by itself");
        self.drive.asked();
        self.machine.succeed("sleep 6");
        Check.equal(self.drive.asked(), "", "none of the folder's bytes are asked of the Drive meanwhile");
        Check.equal(self.logged("no room for it on the disk"), "1", "the log says it once, not once a try");
        Check.equal(self.drive.state("Docs/kept.bin"), "local", "a downloaded file outside the folder was not given back for the room");
        self.machine.succeed(f"cmp {self.mount}/Docs/kept.bin {self.source}/kept && test \"$(cat {self.mount}/notes.txt)\" = 'written here'");
        Check.equal(self.machine.succeed(f"ls {self.store}/trash | wc -l").trim(), "0", "nothing here went to the trash");
        Check.equal(self.drive.trashed(), "", "and nothing on the Drive did");

        print("When there is room again the rest arrives");
        self.machine.succeed(f"rm {self.store}/filler");
        self.waitsFor(" 0 to download");
        for name in self.pinned {
            Check.equal(self.drive.state(f"Game/{name}.bin"), "local", f"{name}.bin is here");
            self.machine.succeed(f"cmp {self.mount}/Game/{name}.bin {self.source}/{name}");
        }
        Check.that(!self.status().contains("no room"), "and the status no longer speaks of room");
    }

    private void driveFull() {
        print("The Drive has no room for what is sent");
        string first = self.drive.sha(f"{self.mount}/notes.txt");
        self.drive.control("quota?bytes=1");
        self.machine.succeed(f"echo 'a new save' > {self.mount}/Game/save.dat && echo 'and more' >> {self.mount}/notes.txt");
        self.machine.waitUntil("journalctl -u drive-engine.service --no-pager | grep -q 'storage quota has been exceeded'");  // the Drive has said no
        Check.equal(self.drive.remote("save.dat"), "", "the new file is not on the Drive");
        Check.that(self.drive.onDrive("notes.txt", first), "the changed one is there as it was");
        Check.equal(self.machine.succeed(f"cat {self.mount}/Game/save.dat {self.mount}/notes.txt"), "a new save\nwritten here\nand more\n", "and both are here, whole");

        print("While it waits it does not send again, and deletes nothing to make room");
        self.requests();
        self.machine.succeed("sleep 8");
        int sent = self.times(self.requests(), "PUT /upload");
        Check.that(sent == 0, f"once refused, nothing is sent again while it waits: {sent} uploads in eight seconds");
        Check.equal(self.logged("storage quota has been exceeded"), "1", "the log has the Drive's refusal once, not once a second");
        Check.equal(self.drive.trashed(), "", "nothing on the Drive was deleted");
        self.waitsFor("^online.* 2 changes to send (the Drive is full)");  // both changes still wait, and the status says why without calling it being offline

        print("When the Drive has room again what was waiting is sent");
        self.drive.control("quota?bytes=-1");
        self.waitsFor(" 0 changes to send", 90);  // it asks again half a minute after the refusal
        Check.that(self.drive.onDrive("save.dat", self.drive.sha(f"{self.mount}/Game/save.dat")) && self.drive.onDrive("notes.txt", self.drive.sha(f"{self.mount}/notes.txt")), "both are on the Drive as they are here");
        Check.equal(f"{self.timesOnDrive("save.dat")} {self.timesOnDrive("notes.txt")}", "1 1", "each of them once");
        Check.that(!self.status().contains("full"), "and the status no longer speaks of a full Drive");
    }

    private void signedOut() {
        print("The sign-in is withdrawn while the engine runs");
        string process = self.machine.succeed("systemctl show -p MainPID --value drive-engine.service").trim();
        self.machine.succeed(f"cd {self.mount} && find . | LC_ALL=C sort > /tmp/before");
        self.drive.control("revoke?accept=signed-in-again");
        self.machine.succeed(f"echo 'made while signed out' > {self.mount}/Game/later.dat");
        self.drive.put(self.game, "theirs.bin", "text");
        self.waitsFor("^sign-in refused.* 1 changes to send");
        Check.that(self.logged("refused the stored sign-in") != "0", "the status says the sign-in is refused, what was made here waits to be sent, and the log has the reason");

        print("Nothing is taken for deleted, and the engine does not ask over and over");
        Check.equal(self.machine.succeed(f"cd {self.mount} && find . | LC_ALL=C sort > /tmp/refused && LC_ALL=C comm -23 /tmp/before /tmp/refused").trim(), "", "nothing that was here is gone");
        Check.equal(self.machine.succeed("LC_ALL=C comm -13 /tmp/before /tmp/refused").trim(), "./Game/later.dat", "and what was made meanwhile is here with it");
        Check.equal(self.machine.succeed(f"ls {self.store}/trash | wc -l").trim(), "0", "nothing here went to the trash");
        Check.equal(self.drive.trashed(), "", "and nothing on the Drive did");
        string said = self.logged("drive:");
        self.requests();
        self.machine.succeed("sleep 10");
        int tokens = self.times(self.requests(), "POST /token");
        Check.that(tokens >= 1 && tokens <= 15, f"it asks for a token when it next reads the feed, every second here, and no faster: {tokens} times in ten seconds");
        Check.equal(self.logged("drive:"), said, "and it does not fill the log while it waits");
        Check.that(self.status().startsWith("sign-in refused"), "the status still says so");

        print("After signing in again it carries on without a restart and sends what was waiting");
        self.machine.succeed("echo '{\"client_id\":\"c\",\"client_secret\":\"s\",\"refresh_token\":\"signed-in-again\"}' > /var/lib/drive-test/credentials.new && mv /var/lib/drive-test/credentials.new /var/lib/drive-test/credentials.json");
        self.waitsFor("^online.* 0 changes to send");
        self.machine.waitUntil(f"cmp -s {self.store}/tree/Game/theirs.bin {self.source}/text");
        Check.that(self.drive.onDrive("later.dat", self.drive.sha(f"{self.mount}/Game/later.dat")), "what was made while signed out is on the Drive");
        Check.equal(self.timesOnDrive("later.dat"), "1", "once");
        Check.equal(self.machine.succeed("systemctl show -p MainPID --value drive-engine.service").trim(), process, "and the engine is the one that was running all along");
    }

    private void nothingLost(string what) {
        self.machine.succeed(f"cmp {self.mount}/Docs/kept.bin {self.source}/kept");
        Check.equal(self.machine.succeed(f"ls {self.store}/trash | wc -l").trim(), "0", what);
    }

    private void doubted() {
        print("The Drive reports a change to a file and nothing readable about the file");
        Check.equal(self.machine.succeed(f"cat {self.store}/format").trim(), "1", "the store says which format it is in");
        string kept = self.drive.id("Docs/kept.bin");
        self.drive.control(f"garble?id={kept}");
        self.drive.put("root", "after.txt", "text");  // a change after it: when this is here, the other has been read
        self.machine.waitUntil(f"cmp -s {self.mount}/after.txt {self.source}/text");
        self.nothingLost("it is not taken for a deletion: the file is here, whole, and nothing went to the trash");
        Check.equal(self.logged("a change to .* that cannot be read"), "1", "and the log says which change was left out");

        print("The Drive no longer has the place its changes were read to");
        self.drive.stop("drive-engine");
        self.machine.succeed(f"echo 999999 > {self.store}/position");
        self.drive.control(f"delete?id={kept}");  // deleted on the Drive while no feed leads to it
        self.drive.put("root", "since.txt", "text");
        self.drive.startEngine(self.engine);
        self.drive.connected();
        self.machine.waitUntil(f"cmp -s {self.mount}/since.txt {self.source}/text");
        Check.equal(self.logged("reading the whole Drive again"), "1", "the log says once that the whole Drive is read again");
        Check.that(self.machine.succeed(f"cat {self.store}/position").trim() != "999999", "the store stands at a place the Drive knows");
        self.nothingLost("what the Drive deleted meanwhile is still here, and nothing went to the trash");
        self.waitsFor("^online");

        print("A store in a format this client does not know");
        self.drive.stop("drive-engine");
        self.machine.succeed(f"echo 2 > {self.store}/format && find {self.store} -xdev -not -path '*/tmp/*' | LC_ALL=C sort > /tmp/store-before");
        string engine = self.machine.fail(f"drive engine --store {self.store} --runtime {self.drive.runtime} --credentials /var/lib/drive-test/credentials.json --api {self.drive.fake} 2>&1");
        Check.that(engine.contains("is in format '2' and this client reads format 1"), f"the engine does not start on it, and says why: {engine}");
        string door = self.machine.fail(f"mkdir -p /mnt/second && drive door --store {self.store} --mount /mnt/second --runtime /run/drive-second 2>&1");
        Check.that(door.contains("is in format '2' and this client reads format 1"), f"neither does a door: {door}");
        Check.equal(self.machine.succeed(f"find {self.store} -xdev -not -path '*/tmp/*' | LC_ALL=C sort | diff /tmp/store-before - && cat {self.store}/format").trim(), "2", "and nothing in the store was touched");
        self.machine.succeed(f"echo 1 > {self.store}/format");
        self.drive.startEngine(self.engine);
        self.waitsFor("^online.* 0 changes to send");
    }

    public void check() {
        self.prepare();
        self.diskFull();
        self.driveFull();
        self.signedOut();
        self.doubted();
    }
}

int main(Vector<string> args) {
    try {
        var lab = Lab(CLIArgs.from(args).require(0, "Supply VM descriptor"));
        RefusalScenario(lab.guest("machine")).check();
        lab.close();
        print("PASS: a full disk, a full Drive, a withdrawn sign-in and a Drive or store in doubt are said, waited out and cost nothing");
        return 0;
    } catch (string error) {
        print(error);
        return 1;
    }
    return 1;
}
